---
import { getImage } from "astro:assets";
import type { Language } from "@bxl/schema";
import { site, theme, languages, defaultLang, t, path, subPath } from "../lib/client.ts";
import { htmlLang, ui } from "../lib/i18n.ts";
import { localBusinessJsonLd } from "../lib/seo.ts";
import { media } from "../lib/media.ts";
import { apiEndpoint } from "../lib/api.ts";
import "../styles/global.css";

interface Props {
  lang: Language;
  /** Une page d'état (suspendu, 404) ne doit jamais être indexée. */
  noindex?: boolean;
  /**
   * Identité de la page secondaire.
   *
   * Sans elles, mentions légales, annulation et page introuvable héritaient
   * du titre et de l'adresse canonique de l'accueil : trois onglets
   * indiscernables pour le visiteur, et une page qui se déclare copie d'une
   * autre auprès de Google.
   */
  pageTitle?: string;
  pageDescription?: string;
  /**
   * Segment de la page, sans barres — « legal », « annulation ». Sert à
   * l'adresse canonique et aux variantes de langue, qui doivent désigner la
   * page équivalente et non l'accueil.
   */
  segment?: string;
}

const {
  lang,
  noindex = false,
  pageTitle,
  pageDescription,
  segment,
} = Astro.props;

const homeTitle =
  t(site.seo.title, lang) ||
  `${site.business.name} — ${t(site.business.tagline, lang) || site.business.address.city}`;

const title = pageTitle ? `${pageTitle} — ${site.business.name}` : homeTitle;

const description =
  pageDescription ||
  t(site.seo.description, lang) ||
  t(site.business.description, lang);

/*
 * Les variantes de langue ne valent qu'entre pages équivalentes : sur les
 * mentions légales néerlandaises, annoncer l'accueil français comme traduction
 * est une déclaration que Google vérifie, et invalide en bloc quand elle est
 * fausse.
 */
const pathFor = (l: Language): string =>
  segment ? subPath(l, segment) : path(l);

const canonical = new URL(pathFor(lang), Astro.site).href;

// Les cartes et les boutons ne suivent pas la même géométrie : « round »
// signifie carte arrondie et bouton en pilule, comme sur les pages Apple.
const radiusCard = { none: "0", soft: "10px", round: "18px" }[theme.radius];
const radiusButton = { none: "0", soft: "8px", round: "980px" }[theme.radius];

const themeVars = [
  `--c-bg:${theme.palette.bg}`,
  `--c-surface:${theme.palette.surface}`,
  `--c-text:${theme.palette.text}`,
  `--c-muted:${theme.palette.muted}`,
  `--c-accent:${theme.palette.accent}`,
  `--c-accent-text:${theme.palette.accentText}`,
  `--c-border:${theme.palette.border}`,
  `--font-display:${theme.fonts.display}`,
  `--font-body:${theme.fonts.body}`,
  `--display-weight:${theme.fonts.displayWeight}`,
  `--display-tracking:${theme.fonts.displayTracking}`,
  `--display-transform:${theme.fonts.displayTransform}`,
  `--ui-transform:${theme.fonts.uiTransform}`,
  `--ui-tracking:${theme.fonts.uiTracking}`,
  `--radius:${radiusCard}`,
  `--radius-btn:${radiusButton}`,
  `--blur:${theme.effects.blur}px`,
].join(";");

// Image de partage : c'est elle qui s'affiche quand le commerçant envoie son
// lien sur WhatsApp ou l'épingle sur Facebook. Elle compte autant que le site.
const shareImage = await getImage({
  src: media(site.hero.image),
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
});
const shareImageUrl = Astro.site
  ? new URL(shareImage.src, Astro.site).href
  : shareImage.src;

const jsonLd = localBusinessJsonLd(lang, Astro.site, shareImageUrl);

const collectUrl = site.tenantId ? apiEndpoint("/v1/collect") : undefined;

/**
 * Mesure d'audience, sans cookie et sans identifiant persistant.
 *
 * Elle existe pour une raison commerciale précise : le rapport mensuel envoyé
 * au commerçant lui montre ce qu'il paie, et c'est la meilleure défense contre
 * la résiliation. Les événements suivis sont ceux qui le convainquent — appels,
 * itinéraires, demandes de rendez-vous — pas des indicateurs abstraits.
 *
 * Aucune donnée n'est lue sur l'appareil du visiteur : ni cookie, ni stockage
 * local. D'où l'absence de bandeau de consentement, ce qui préserve aussi le
 * design de la page.
 */
const collectScript = `(function(){
  var url = ${JSON.stringify(collectUrl ?? "")};
  var tenant = ${JSON.stringify(site.tenantId ?? "")};
  if (!url || !tenant || !navigator.sendBeacon) return;

  function send(kind) {
    try {
      // Type « text/plain » et non « application/json » : c'est un type
      // autorisé d'office par le navigateur, donc la balise part sans
      // requête préalable et sans contrôle d'origine. En JSON, la mesure
      // ne partait pas du tout dès que l'API vivait sur un autre domaine —
      // c'est-à-dire toujours, en production.
      navigator.sendBeacon(url, new Blob([JSON.stringify({
        tenantId: tenant,
        kind: kind,
        path: location.pathname,
        lang: ${JSON.stringify(lang)},
        referrer: document.referrer || undefined
      })], { type: "text/plain" }));
    } catch (e) {}
  }

  send("view");

  // Les clics qui comptent pour le commerçant, reconnus par la destination du
  // lien plutôt que par des marqueurs à poser sur chaque bouton.
  document.addEventListener("click", function (event) {
    var link = event.target.closest && event.target.closest("a");
    if (!link) return;
    var href = link.getAttribute("href") || "";
    if (href.indexOf("tel:") === 0) return send("call");
    if (href.indexOf("google.com/maps") !== -1 || href.indexOf("maps.app") !== -1) return send("directions");
    if (href.indexOf("#reservation") !== -1) return send("booking");
    if (link.rel && link.rel.indexOf("me") !== -1) return send("social");
  }, { passive: true });

  // Envois de formulaire : la demande de rendez-vous et le message de contact.
  document.addEventListener("submit", function (event) {
    var action = (event.target.getAttribute("action") || "");
    if (action.indexOf("/v1/booking-requests") !== -1) return send("booking");
    if (action.indexOf("/v1/contact") !== -1) return send("contact");
  }, { passive: true });
})();`;

/**
 * Apparition en fondu au défilement.
 *
 * La classe qui masque est posée par ce script, jamais présente dans le HTML
 * livré : sans JavaScript — ou si le script échoue — tout le contenu reste
 * visible. Un effet décoratif ne doit jamais pouvoir rendre illisible le site
 * d'un client.
 */
const revealScript = `(function(){
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  if (!("IntersectionObserver" in window)) return;
  var targets = document.querySelectorAll(".section__head, .service, .gallery figure, .team li, .review, .cta__title, .cta__actions, .hours, .contact__list");
  if (!targets.length) return;

  function revealAll() {
    for (var i = 0; i < targets.length; i++) {
      targets[i].setAttribute("data-revealed", "true");
    }
  }

  // Arrivée directe sur une ancre : la page ne défile pas depuis le haut, donc
  // on affiche tout plutôt que de risquer une section restée invisible.
  if (location.hash) return;

  for (var i = 0; i < targets.length; i++) targets[i].classList.add("reveal-target");

  var io = new IntersectionObserver(function (entries) {
    for (var j = 0; j < entries.length; j++) {
      if (!entries[j].isIntersecting) continue;
      entries[j].target.setAttribute("data-revealed", "true");
      io.unobserve(entries[j].target);
    }
  }, { rootMargin: "0px 0px -10% 0px" });
  for (var k = 0; k < targets.length; k++) io.observe(targets[k]);

  // Filets de sécurité : impression, et saut vers une ancre en cours de visite.
  window.addEventListener("beforeprint", revealAll);
  window.addEventListener("hashchange", revealAll);
})();`;

/**
 * Amélioration des formulaires : envoi en arrière-plan quand `fetch` est
 * disponible, sinon le navigateur poste normalement et l'API renvoie vers la
 * page avec `?sent=1#envoi-ok`.
 *
 * La confirmation du second chemin est affichée par CSS, via `:target` — pas
 * par ce script, qui ne s'exécute justement pas chez ceux qui l'empruntent.
 * Ce bloc-ci ne sert qu'au cas résiduel d'un navigateur qui a JavaScript mais
 * pas `fetch` : il écrit le message dans le formulaire et retire l'ancre, pour
 * ne pas afficher les deux à la fois.
 *
 * Un seul script pour tous les formulaires de la page : les libellés
 * traduits voyagent dans les attributs `data-label-*` du formulaire.
 */
const formScript = `(function(){
  var forms = document.querySelectorAll("form[data-async-form]");
  if (!forms.length) return;

  // Retour d'un envoi sans JavaScript.
  var sent = new URLSearchParams(location.search).get("sent");
  if (sent !== null) {
    var first = forms[0];
    var box = first.querySelector(".form-status");
    if (box) {
      var okLabel = first.getAttribute("data-label-ok");
      var koLabel = first.getAttribute("data-label-error");
      box.setAttribute("data-state", sent === "1" ? "ok" : "error");
      box.textContent = sent === "1" ? okLabel : koLabel;
      if (sent === "1") first.reset();
    }
    // L'ancre de retour est retirée en même temps que le paramètre : la
    // laisser afficherait le bandeau sans JavaScript par-dessus le message
    // que ce script vient d'écrire.
    var hash = location.hash === "#envoi-ok" || location.hash === "#envoi-ko"
      ? ""
      : location.hash;
    history.replaceState(null, "", location.pathname + hash);
  }

  if (!window.fetch) return;

  for (var i = 0; i < forms.length; i++) {
    (function (form) {
      var status = form.querySelector(".form-status");
      var button = form.querySelector("button[type=submit]");
      var trap = form.querySelector("[name=_company]");

      form.addEventListener("submit", function (event) {
        if (trap && trap.value) { event.preventDefault(); return; }
        event.preventDefault();

        button.disabled = true;
        button.textContent = form.getAttribute("data-label-sending");
        if (status) { status.textContent = ""; status.removeAttribute("data-state"); }

        /*
         * URLSearchParams et non FormData : ce dernier part en
         * multipart/form-data, que l'API n'accepte pas — elle recevrait un
         * 415 et le visiteur verrait un échec sans raison apparente. Aucun de
         * ces formulaires n'envoie de fichier, donc l'encodage classique
         * suffit, et c'est aussi celui qu'utilise le navigateur sans
         * JavaScript : les deux chemins deviennent identiques.
         */
        fetch(form.action, {
          method: "POST",
          body: new URLSearchParams(new FormData(form)),
          headers: { Accept: "application/json" }
        })
          .then(function (response) {
            /*
             * 409 veut dire « quelqu'un a réservé pendant que vous
             * remplissiez » : ce n'est pas une panne, et le message doit
             * inviter à choisir un autre créneau. Toute autre erreur reçoit
             * le message générique — annoncer un créneau pris alors que le
             * formulaire est incomplet enverrait le visiteur sur une fausse
             * piste.
             */
            if (response.status === 409) {
              var e = new Error("conflict");
              e.name = "Conflict";
              throw e;
            }
            if (!response.ok) throw new Error(String(response.status));
            form.reset();
            if (status) {
              status.setAttribute("data-state", "ok");
              status.textContent = form.getAttribute("data-label-ok");
            }
            if (form.hasAttribute("data-reload-on-success")) {
              form.dispatchEvent(new CustomEvent("bxl:booked", { bubbles: true }));
            }
          })
          .catch(function (error) {
            if (status) {
              status.setAttribute("data-state", "error");
              status.textContent =
                error && error.name === "Conflict"
                  ? form.getAttribute("data-label-conflict") ||
                    form.getAttribute("data-label-error")
                  : form.getAttribute("data-label-error");
            }
          })
          .finally(function () {
            button.disabled = false;
            button.textContent = form.getAttribute("data-label-send");
          });
      });
    })(forms[i]);
  }
})();`;
---

<!doctype html>
<html lang={htmlLang(lang)} style={themeVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={theme.palette.bg} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content={site.business.name} />

    {
      /* Un site de démonstration ou une page d'état ne doit pas polluer
         l'index de Google — ni concurrencer le vrai site d'un client. */
      (noindex || site.demo || site.status !== "live") && (
        <meta name="robots" content="noindex,nofollow" />
      )
    }

    {
      languages.map((l) => (
        <link
          rel="alternate"
          hreflang={htmlLang(l)}
          href={new URL(pathFor(l), Astro.site).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(pathFor(defaultLang), Astro.site).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={htmlLang(lang).replace("-", "_")} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      !noindex && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
          is:inline
        />
      )
    }
  </head>

  <body
    data-grain={String(theme.grain)}
    data-notice={String(site.demo)}
    data-glass={String(theme.effects.glass)}
    data-reveal={String(theme.effects.reveal)}
  >
    <a class="skip" href="#content">{ui(lang, "skip_to_content")}</a>
    {site.demo && <p class="notice">{ui(lang, "demo_notice")}</p>}

    {
      /*
       * Retour d'un envoi de formulaire sans JavaScript.
       *
       * L'API renvoie vers `#envoi-ok` ou `#envoi-ko`, et c'est `:target` qui
       * fait apparaître le bandeau : aucun script n'intervient. C'est la seule
       * façon de tenir la promesse du formulaire sans JavaScript — la version
       * précédente écrivait la confirmation en JavaScript, donc ne l'affichait
       * jamais aux visiteurs qui en sont dépourvus, les seuls à emprunter ce
       * chemin.
       *
       * Ces bandeaux n'occupent aucune place tant qu'ils ne sont pas visés.
       */
    }
    <p id="envoi-ok" class="envoi envoi--ok" role="status">
      {ui(lang, "form_ok")}
    </p>
    <p id="envoi-ko" class="envoi envoi--ko" role="status">
      {ui(lang, "form_error")}
    </p>

    <slot />

    {theme.effects.reveal && <script is:inline set:html={revealScript} />}
    <script is:inline set:html={formScript} />
    {collectUrl && <script is:inline set:html={collectScript} />}
  </body>
</html>
