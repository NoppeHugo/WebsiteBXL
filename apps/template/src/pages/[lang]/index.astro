---
import type { Language } from "@bxl/schema";
import { secondaryLanguages } from "../../lib/client.ts";
import Home from "../../components/Home.astro";

export function getStaticPaths() {
  // Seules les langues effectivement activées pour ce client sont générées :
  // un site Essentiel monolingue ne produit aucune page superflue.
  return secondaryLanguages().map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Language;
---

<Home lang={lang} />
