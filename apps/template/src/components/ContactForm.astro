---
import type { Language } from "@bxl/schema";
import { site, path } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";
import { apiEndpoint } from "../lib/api.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

/**
 * Deux points d'envoi possibles : notre API, ou un prestataire externe déclaré
 * dans `contact.formEndpoint` pour les clients installés avant l'API. Sans
 * l'un ni l'autre, aucun formulaire n'est rendu — mieux vaut le téléphone
 * qu'un formulaire qui perd les messages.
 */
const ownEndpoint = site.tenantId ? apiEndpoint("/v1/contact") : undefined;
const endpoint = ownEndpoint ?? site.contact.formEndpoint;

const returnUrl = Astro.site ? new URL(path(lang), Astro.site).href : undefined;
---

{
  endpoint && (
    <div class="contact-form">
      <h3>{ui(lang, "form_title")}</h3>

      <form
        method="post"
        action={endpoint}
        data-async-form
        data-label-sending={ui(lang, "form_sending")}
        data-label-ok={ui(lang, "form_ok")}
        data-label-error={ui(lang, "form_error")}
        data-label-incomplete={ui(lang, "form_incomplete")}
        data-label-send={ui(lang, "form_send")}
      >
        {ownEndpoint && (
          <>
            <input type="hidden" name="tenantId" value={site.tenantId} />
            <input type="hidden" name="locale" value={lang} />
            {returnUrl && (
              <input type="hidden" name="redirectTo" value={returnUrl} />
            )}
          </>
        )}

        <label>
          <span>{ui(lang, "form_name")}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>

        <label>
          <span>{ui(lang, "form_email")}</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>

        <label>
          <span>{ui(lang, "form_message")}</span>
          <textarea name="message" rows="4" required />
        </label>

        <input
          type="text"
          name="_company"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          class="honeypot"
        />

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            {ui(lang, "form_consent")}{" "}
            <a href={`${path(lang)}legal/`}>{ui(lang, "legal")}</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primary">
          {ui(lang, "form_send")}
        </button>

        <p class="form-status" role="status" aria-live="polite" />
      </form>
    </div>
  )
}

<style>
  .contact-form {
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .contact-form h3 {
    font-size: var(--step-1);
    margin-bottom: 1.25rem;
  }

  .contact-form form {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }
</style>
