---
import type { Language } from "@bxl/schema";
import { Image } from "astro:assets";
import { site, t } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";
import { media } from "../lib/media.ts";
import { bookingTarget } from "../lib/booking.ts";

/**
 * Les occasions.
 *
 * L'entrée principale d'un site de fleuriste, et la différence la plus nette
 * avec un site de coiffeur. Personne ne cherche « bouquet rond de saison » :
 * on cherche des fleurs *pour* un mariage, *pour* une naissance, *pour* un
 * enterrement. La navigation d'un fleuriste suit donc l'événement du client,
 * pas le catalogue du commerce.
 *
 * Le prix est toujours dit « à partir de ». Un fleuriste ne peut pas annoncer
 * un prix ferme : ce qu'il compose dépend de l'arrivage du matin, et un prix
 * ferme affiché serait tenu contre lui.
 *
 * Chaque carte descend vers le formulaire de commande **avec son occasion déjà
 * choisie**. Sans cela, le client qui vient de cliquer sur « Mariage » devait
 * rouvrir la même liste trois écrans plus bas, et rien ne disait que les deux
 * parlaient de la même chose.
 */

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const prix = new Intl.NumberFormat(`${lang}-BE`, {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
});

// Le lien ne s'affiche que si le formulaire est réellement sur la page.
const commande = bookingTarget(lang);

/*
 * Report du choix sur le formulaire.
 *
 * Le rapprochement se fait sur le libellé traduit, qui est aussi la valeur des
 * options — c'est ce que le formulaire envoie au commerçant. Une occasion qui
 * ne s'y retrouve pas laisse simplement le choix vide : le client corrige,
 * plutôt que de partir avec « Mariage » alors qu'il avait cliqué « Naissance ».
 */
const prefillScript = `(function(){
  document.addEventListener("click", function (event) {
    var lien = event.target.closest && event.target.closest("[data-occasion]");
    if (!lien) return;
    var champ = document.querySelector('.commande select[name="occasionName"]');
    if (!champ) return;
    var voulue = lien.getAttribute("data-occasion");
    for (var i = 0; i < champ.options.length; i++) {
      if (champ.options[i].value === voulue) {
        champ.value = voulue;
        break;
      }
    }
  }, { passive: true });
})();`;
---

<section class="section" id="occasions">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title">{ui(lang, "occasions_title")}</h2>
    </div>

    <div class="occasions">
      {
        site.occasions.map((occasion) => (
          <article class="occasion">
            {occasion.photo && (
              <div class="occasion__media">
                <Image
                  src={media(occasion.photo)}
                  alt={t(occasion.title, lang)}
                  widths={[400, 700]}
                  sizes="(min-width: 60rem) 22rem, 90vw"
                  loading="lazy"
                />
              </div>
            )}
            <div class="occasion__texte">
              <h3 class="occasion__titre">{t(occasion.title, lang)}</h3>
              {occasion.text && <p class="occasion__desc">{t(occasion.text, lang)}</p>}
              {occasion.price !== null && (
                <p class="occasion__prix">
                  {ui(lang, "from_price")} {prix.format(occasion.price)}
                </p>
              )}
              {commande.enabled && !commande.external && (
                <a
                  class="occasion__lien"
                  href={commande.href}
                  data-occasion={t(occasion.title, lang)}
                >
                  {ui(lang, "book")}
                </a>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

{commande.enabled && !commande.external && <script is:inline set:html={prefillScript} />}
