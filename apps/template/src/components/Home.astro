---
import type { Language } from "@bxl/schema";
import { site } from "../lib/client.ts";
import Base from "../layouts/Base.astro";
import Nav from "./Nav.astro";
import Hero from "./Hero.astro";
import Services from "./Services.astro";
import Gallery from "./Gallery.astro";
import Steps from "./Steps.astro";
import Team from "./Team.astro";
import Reviews from "./Reviews.astro";
import Info from "./Info.astro";
import BookingCta from "./BookingCta.astro";
import Footer from "./Footer.astro";
import ActionBar from "./ActionBar.astro";
import Suspended from "./Suspended.astro";
import Occasions from "./Occasions.astro";
import Deuil from "./Deuil.astro";
import Livraison from "./Livraison.astro";
import Abonnement from "./Abonnement.astro";
import Commande from "./Commande.astro";
import Carte from "./Carte.astro";
import Planning from "./Planning.astro";
import Table from "./Table.astro";
import { metierDe } from "@bxl/schema/metiers";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const metier = metierDe(site.business.type);

// Chaque section ne s'affiche que si le client a fourni le contenu
// correspondant : c'est ce qui permet à un palier Essentiel (une page, peu de
// contenu) et à un palier Signature de partager exactement le même template.
const suspended = site.status === "suspended";
---

{
  suspended ? (
    <Suspended lang={lang} />
  ) : (
    <Base lang={lang}>
      <Nav lang={lang} />
      <main id="content">
        <Hero lang={lang} />
        {/*
          L'ordre suit ce que cherche le client du commerce, pas ce que le
          commerce a envie de montrer. Chez un fleuriste, on arrive avec une
          occasion en tête — un mariage, un deuil — et la carte des
          compositions ne vient qu'après. Chez un coiffeur, la prestation est
          l'entrée : on sait déjà ce qu'on vient faire.
        */}
        {/*
          La carte et le planning passent avant tout le reste, pour la même
          raison : ce sont eux qu'on vient chercher. Un client qui compare
          trois restaurants à midi moins dix veut la carte, pas la galerie ;
          quelqu'un qui hésite devant une salle de sport veut savoir ce qu'il
          y a le mardi soir.
        */}
        {site.menu.length > 0 && <Carte lang={lang} />}
        {site.courses.length > 0 && <Planning lang={lang} />}
        {site.occasions.length > 0 && <Occasions lang={lang} />}
        {site.services.length > 0 && <Services lang={lang} />}
        {site.gallery.length > 0 && <Gallery lang={lang} />}
        {/* Après la galerie : on a vu le lieu, on raconte ce qui s'y passe.
            Le composant se retire de lui-même en dessous de deux étapes. */}
        <Steps lang={lang} />
        {site.team.length > 0 && <Team lang={lang} />}
        {site.reviews.length > 0 && <Reviews lang={lang} />}
        {/*
          Le deuil se place après les avis et avant la livraison : assez bas
          pour ne pas assombrir l'accueil, assez haut pour être trouvé sans
          chercher — c'est une section qu'on ouvre dans l'urgence.
        */}
        {site.mourning && <Deuil lang={lang} />}
        {site.subscriptions.length > 0 && <Abonnement lang={lang} />}
        {site.delivery && <Livraison lang={lang} />}
        {metier.commande === "commande" && <Commande lang={lang} />}
        {metier.commande === "table" && <Table lang={lang} />}
        {metier.commande !== "commande" && metier.commande !== "table" && (
          <BookingCta lang={lang} />
        )}
        <Info lang={lang} />
      </main>
      <Footer lang={lang} />
      <ActionBar lang={lang} />
    </Base>
  )
}
