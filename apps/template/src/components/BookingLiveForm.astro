---
import type { Language } from "@bxl/schema";
import { formatPrice } from "@bxl/schema";
import { site, t, path } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";
import { apiEndpoint } from "../lib/api.ts";
import { telHref } from "../lib/booking.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const availabilityUrl = apiEndpoint("/v1/availability");
const bookUrl = apiEndpoint("/v1/appointments");

/**
 * Réservation en agenda temps réel.
 *
 * Le parcours avance par étapes — prestation, jour, heure, coordonnées — et
 * n'affiche qu'une décision à la fois. Tout présenter d'un coup donnait un mur
 * de vingt-six créneaux au-dessus de six champs : exact, mais décourageant, et
 * c'est sur téléphone que se prennent la plupart des rendez-vous. Chaque étape
 * franchie se replie en une ligne de résumé, modifiable d'un geste.
 *
 * Les disponibilités des quinze prochains jours sont chargées en une seule
 * requête : la bande de dates montre d'emblée les jours fermés ou complets, et
 * passer d'un jour à l'autre n'attend rien.
 *
 * Cette partie exige JavaScript — des créneaux qui changent d'une minute à
 * l'autre ne se rendent pas en HTML statique. Le téléphone reste donc affiché,
 * et `<noscript>` le rappelle.
 */

const returnUrl = Astro.site ? new URL(path(lang), Astro.site).href : undefined;

const services = site.services.map((service) => ({
  id: service.id,
  name: t(service.name, lang),
  durationMin: service.durationMin,
  price: formatPrice(service, lang),
}));
---

{
  availabilityUrl && bookUrl && site.tenantId && services.length > 0 && (
    <div
      class="rdv"
      data-live-booking
      data-availability={availabilityUrl}
      data-tenant={site.tenantId}
      data-lang={lang}
      data-business={site.business.name}
      data-address={`${site.business.address.street}, ${site.business.address.postalCode} ${site.business.address.city}`}
      data-label-closed={ui(lang, "booking_closed_short")}
      data-label-full={ui(lang, "booking_full_short")}
      data-label-loading={ui(lang, "booking_slots_loading")}
      data-label-empty={ui(lang, "booking_slots_empty")}
      data-label-need-service={ui(lang, "booking_need_service")}
      data-label-need-slot={ui(lang, "booking_need_slot")}
      data-label-morning={ui(lang, "period_morning")}
      data-label-afternoon={ui(lang, "period_afternoon")}
      data-label-evening={ui(lang, "period_evening")}
      data-label-change={ui(lang, "booking_change")}
    >
      <form
        method="post"
        action={bookUrl}
        data-async-form
        data-label-sending={ui(lang, "form_sending")}
        data-label-ok={ui(lang, "booking_live_ok")}
        data-label-error={ui(lang, "form_error")}
        data-label-conflict={ui(lang, "booking_taken")}
        data-reload-on-success
        data-label-send={ui(lang, "booking_confirm")}
      >
        <input type="hidden" name="tenantId" value={site.tenantId} />
        <input type="hidden" name="locale" value={lang} />
        {returnUrl && <input type="hidden" name="redirectTo" value={returnUrl} />}
        <input type="hidden" name="serviceId" data-field-service required />
        <input type="hidden" name="startsAt" data-field-slot required />

        {/* Étape 1 — la prestation */}
        <section class="rdv__step" data-step="service" data-open="true">
          <header class="rdv__head">
            <p class="rdv__label">{ui(lang, "booking_step_service")}</p>
            <p class="rdv__chosen" data-summary="service" />
          </header>

          <div class="rdv__body">
            <div class="rdv__clip">
            <ul class="rdv__services">
              {services.map((service) => (
                <li>
                  <button
                    type="button"
                    class="rdv__service"
                    data-service-id={service.id}
                    data-service-name={service.name}
                    data-service-duration={service.durationMin}
                    data-service-price={service.price}
                  >
                    <span class="rdv__service-name">{service.name}</span>
                    <span class="rdv__service-meta">
                      {service.durationMin} {ui(lang, "minutes")}
                    </span>
                    <span class="rdv__service-price">{service.price}</span>
                  </button>
                </li>
              ))}
            </ul>
            </div>
          </div>
        </section>

        {/* Étape 2 — le jour */}
        <section class="rdv__step" data-step="day">
          <header class="rdv__head">
            <p class="rdv__label">{ui(lang, "booking_step_day")}</p>
            <p class="rdv__chosen" data-summary="day" />
          </header>
          <div class="rdv__body">
            <div class="rdv__clip"><div class="rdv__days" data-days /></div>
          </div>
        </section>

        {/* Étape 3 — l'heure */}
        <section class="rdv__step" data-step="time">
          <header class="rdv__head">
            <p class="rdv__label">{ui(lang, "booking_step_time")}</p>
            <p class="rdv__chosen" data-summary="time" />
          </header>
          <div class="rdv__body">
            <div class="rdv__clip"><div class="rdv__slots" data-slots aria-live="polite" /></div>
          </div>
        </section>

        {/* Étape 4 — les coordonnées */}
        <section class="rdv__step" data-step="you">
          <header class="rdv__head">
            <p class="rdv__label">{ui(lang, "booking_step_you")}</p>
          </header>

          <div class="rdv__body">
            <div class="rdv__clip">
            <div class="rdv__you">
            <div class="rdv__fields">
              <label>
                <span>{ui(lang, "form_name")}</span>
                <input type="text" name="name" required autocomplete="name" />
              </label>
              <label>
                <span>{ui(lang, "form_email")}</span>
                <input type="email" name="email" required autocomplete="email" />
              </label>
            </div>

            {/* Le superflu reste replié : Apple ne demande jamais plus que
                nécessaire à l'écran. */}
            <details class="rdv__more">
              <summary>{ui(lang, "booking_more")}</summary>
              <div class="rdv__fields">
                <label>
                  <span>{ui(lang, "booking_phone")}</span>
                  <input type="tel" name="phone" autocomplete="tel" />
                </label>
                <label>
                  <span>{ui(lang, "booking_note")}</span>
                  <input type="text" name="note" />
                </label>
              </div>
            </details>

            <input type="text" name="_company" tabindex="-1" autocomplete="off"
                   aria-hidden="true" class="honeypot" />

            <label class="consent rdv__consent">
              <input type="checkbox" name="consent" required />
              <span>
                {ui(lang, "form_consent")}{" "}
                <a href={`${path(lang)}legal/`}>{ui(lang, "legal")}</a>
              </span>
            </label>

            <p class="rdv__recap" data-recap />

            <button type="submit" class="rdv__confirm" disabled data-submit>
              {ui(lang, "booking_confirm")}
            </button>

            <p class="form-status" role="status" aria-live="polite" />
            </div>
            </div>
          </div>
        </section>
      </form>

      {/* Panneau de confirmation, substitué au formulaire une fois réservé. */}
      <div class="rdv__done" data-done hidden>
        <svg class="rdv__check" viewBox="0 0 52 52" aria-hidden="true">
          <circle cx="26" cy="26" r="24" />
          <path d="M15 27l8 8 15-16" />
        </svg>
        <h3>{ui(lang, "booking_success_title")}</h3>
        <p class="rdv__done-when" data-done-when />
        <p class="rdv__done-body">{ui(lang, "booking_success_body")}</p>
        <a class="rdv__ics" data-ics download="rendez-vous.ics" hidden>
          {ui(lang, "booking_add_calendar")}
        </a>
        <button type="button" class="rdv__again" data-again>
          {ui(lang, "booking_again")}
        </button>
      </div>

      <noscript>
        <p class="rdv__noscript">
          {ui(lang, "booking_needs_js")}{" "}
          <a href={telHref()}>{site.business.phone}</a>
        </p>
      </noscript>
    </div>
  )
}

<script src="../scripts/booking.ts"></script>
