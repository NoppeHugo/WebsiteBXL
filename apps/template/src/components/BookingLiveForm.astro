---
import type { Language } from "@bxl/schema";
import { site, t, path } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";
import { apiEndpoint } from "../lib/api.ts";
import { telHref } from "../lib/booking.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const availabilityUrl = apiEndpoint("/v1/availability");
const bookUrl = apiEndpoint("/v1/appointments");

/**
 * Réservation en agenda temps réel (v2).
 *
 * Le client choisit une prestation et un jour, voit les créneaux réellement
 * libres, et confirme. Contrairement à la demande de rendez-vous, c'est une
 * réservation ferme : le courriel qu'il reçoit le dit.
 *
 * Cette partie a besoin de JavaScript — afficher des disponibilités qui
 * changent d'une minute à l'autre ne se fait pas en HTML statique. Le
 * téléphone reste donc affiché, et `<noscript>` le rappelle explicitement :
 * personne ne doit se retrouver devant un encart vide.
 */

const today = new Date().toISOString().slice(0, 10);
const maxDay = new Date(Date.now() + 120 * 86_400_000).toISOString().slice(0, 10);

const returnUrl = Astro.site ? new URL(path(lang), Astro.site).href : undefined;
---

{
  availabilityUrl && bookUrl && site.tenantId && site.services.length > 0 && (
    <div class="booking-form" data-live-booking>
      <h3>{ui(lang, "booking_live_title")}</h3>

      <form
        method="post"
        action={bookUrl}
        data-async-form
        data-label-sending={ui(lang, "form_sending")}
        data-label-ok={ui(lang, "booking_live_ok")}
        data-label-error={ui(lang, "form_error")}
        data-label-conflict={ui(lang, "booking_taken")}
        data-reload-on-success
        data-label-send={ui(lang, "booking_confirm")}
        data-availability={availabilityUrl}
        data-tenant={site.tenantId}
      >
        <input type="hidden" name="tenantId" value={site.tenantId} />
        <input type="hidden" name="locale" value={lang} />
        {returnUrl && <input type="hidden" name="redirectTo" value={returnUrl} />}
        <input type="hidden" name="startsAt" data-slot-value required />

        <div class="booking-form__row">
          <label>
            <span>{ui(lang, "booking_service")}</span>
            <select name="serviceId" required data-service>
              {site.services.map((service) => (
                <option value={service.id} data-duration={service.durationMin}>
                  {t(service.name, lang)} — {service.durationMin} {ui(lang, "minutes")}
                </option>
              ))}
            </select>
          </label>

          <label>
            <span>{ui(lang, "booking_date")}</span>
            <input type="date" data-day required min={today} max={maxDay} value={today} />
          </label>
        </div>

        <div
          class="slots"
          data-slots
          aria-live="polite"
          data-label-loading={ui(lang, "booking_slots_loading")}
          data-label-empty={ui(lang, "booking_slots_empty")}
          data-label-error={ui(lang, "form_error")}
        />

        <div class="booking-form__row">
          <label>
            <span>{ui(lang, "form_name")}</span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>{ui(lang, "form_email")}</span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
        </div>

        <label>
          <span>{ui(lang, "booking_phone")}</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>

        <label>
          <span>{ui(lang, "booking_note")}</span>
          <textarea name="note" rows="2" />
        </label>

        <input type="text" name="_company" tabindex="-1" autocomplete="off"
               aria-hidden="true" class="honeypot" />

        <label class="consent">
          <input type="checkbox" name="consent" required />
          <span>
            {ui(lang, "form_consent")}{" "}
            <a href={`${path(lang)}legal/`}>{ui(lang, "legal")}</a>
          </span>
        </label>

        <button type="submit" class="btn btn--primary" disabled data-submit>
          {ui(lang, "booking_confirm")}
        </button>

        <p class="form-status" role="status" aria-live="polite" />
      </form>

      <noscript>
        <p class="booking-form__note">
          {ui(lang, "booking_needs_js")}{" "}
          <a href={telHref()}>{site.business.phone}</a>
        </p>
      </noscript>
    </div>
  )
}

<script>
  /*
   * Chargement des créneaux à chaque changement de prestation ou de date.
   *
   * Le bouton de confirmation reste désactivé tant qu'aucun créneau n'est
   * choisi : sans cela, un envoi partirait sans horaire et l'API le
   * refuserait, ce qui donnerait au visiteur l'impression d'une panne.
   */
  const root = document.querySelector<HTMLElement>("[data-live-booking]");
  if (root) {
    const form = root.querySelector("form")!;
    const service = form.querySelector<HTMLSelectElement>("[data-service]")!;
    const day = form.querySelector<HTMLInputElement>("[data-day]")!;
    const box = form.querySelector<HTMLElement>("[data-slots]")!;
    const hidden = form.querySelector<HTMLInputElement>("[data-slot-value]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const endpoint = form.dataset.availability!;
    const tenant = form.dataset.tenant!;
    const locale = (form.querySelector<HTMLInputElement>("[name=locale]")!).value;

    const time = new Intl.DateTimeFormat(`${locale}-BE`, {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Europe/Brussels",
    });

    let request = 0;

    async function load() {
      const ticket = ++request;
      hidden.value = "";
      submit.disabled = true;
      box.dataset.state = "loading";
      box.textContent = box.dataset.labelLoading ?? "…";

      try {
        const url = new URL(endpoint);
        url.searchParams.set("tenantId", tenant);
        url.searchParams.set("serviceId", service.value);
        url.searchParams.set("day", day.value);

        const response = await fetch(url, { headers: { Accept: "application/json" } });
        const data = await response.json();

        // Une réponse plus lente qu'une autre ne doit pas écraser la plus
        // récente : le visiteur verrait les créneaux d'un autre jour.
        if (ticket !== request) return;

        box.textContent = "";
        box.dataset.state = "";

        if (data.closed || !data.slots?.length) {
          box.dataset.state = "empty";
          box.textContent = box.dataset.labelEmpty ?? "";
          return;
        }

        for (const iso of data.slots) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "slot";
          button.textContent = time.format(new Date(iso));
          button.addEventListener("click", () => {
            for (const other of box.querySelectorAll(".slot")) {
              other.removeAttribute("aria-pressed");
            }
            button.setAttribute("aria-pressed", "true");
            hidden.value = iso;
            submit.disabled = false;
          });
          box.append(button);
        }
      } catch {
        if (ticket !== request) return;
        box.dataset.state = "empty";
        box.textContent = box.dataset.labelError ?? "";
      }
    }

    service.addEventListener("change", load);
    day.addEventListener("change", load);
    // Après une réservation, les créneaux restants ne sont plus les mêmes.
    form.addEventListener("bxl:booked", () => void load());
    void load();
  }
</script>

<style>
  .slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 2.5rem;
    align-items: center;
  }

  .slots[data-state="loading"],
  .slots[data-state="empty"] {
    color: var(--c-muted);
    font-size: var(--step--1);
  }

  .slot {
    font: inherit;
    font-size: var(--step--1);
    color: var(--c-text);
    background: color-mix(in srgb, var(--c-surface) 70%, transparent);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-btn);
    padding: 0.5em 1em;
    cursor: pointer;
    font-variant-numeric: tabular-nums;
  }

  .slot:hover {
    border-color: var(--c-text);
  }

  .slot[aria-pressed="true"] {
    background: var(--c-accent);
    color: var(--c-accent-text);
    border-color: var(--c-accent);
  }
</style>
