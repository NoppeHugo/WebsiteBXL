---
import { Image } from "astro:assets";
import type { Language } from "@bxl/schema";
import { site, theme, t } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";
import { media } from "../lib/media.ts";
import { bookingTarget, telHref } from "../lib/booking.ts";
import { tonalite } from "../lib/tonalite.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

const booking = bookingTarget(lang);
const image = media(site.hero.image);
const variant = theme.layout.hero;

/*
 * Clair ou sombre : mesuré à la construction, sur la bande de l'image où le
 * texte va se poser. Le HTML transporte le résultat, le navigateur n'a rien à
 * calculer — et la couleur reste juste même si la photo change de dominante
 * d'une publication à l'autre.
 */
const ton = await tonalite(site.hero.image, theme.layout.heroAlign);

/*
 * Rapport réel de la photo fournie, transmis au CSS.
 *
 * Imposer un cadre fixe — 4/5 sur téléphone, 16/9 sur écran large — obligeait à
 * recadrer : une photo en 3/2 y perdait les deux tiers de sa largeur, et le
 * sujet s'en trouvait amputé. On croyait l'image trop petite alors qu'elle
 * était surtout mal coupée. Le cadre suit désormais la photo, borné pour qu'un
 * panorama ne s'étire pas en bandeau et qu'un portrait ne pousse pas tout le
 * reste hors de l'écran.
 */
const rapport = Math.min(
  1.6,
  Math.max(0.75, image.width / image.height),
).toFixed(3);
---

<section class={`hero hero--${variant}`} data-align={theme.layout.heroAlign} data-ton={ton} style={`--hero-rapport:${rapport}`}>
  <div class="hero__media" data-hero-media>
    <Image
      src={image}
      alt={t(site.business.tagline, lang) || site.business.name}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={78}
    />

    {
      /*
       * En disposition « overlap », l'accroche et le titre sont ancrés dans la
       * photo elle-même, et non dans le bloc qui la suit.
       *
       * C'est ce qui permet de leur donner la couleur qu'appelle l'image —
       * mesurée à la construction — sans se poser la question du fond de page :
       * ils ne le touchent jamais. Le sous-titre et les boutons, eux, restent
       * dessous, où les couleurs du thème s'appliquent normalement.
       *
       * Les faire simplement remonter par une marge négative aurait entraîné
       * tout le bloc avec eux, sous-titre compris — lequel n'a pas de couleur
       * adaptée et devenait illisible sur la photo.
       */
      variant === "overlap" && (
        <div class="wrap hero__surtitre">
          {site.business.tagline && (
            <p class="eyebrow">{t(site.business.tagline, lang)}</p>
          )}
          <h1 class="hero__title">{t(site.hero.headline, lang)}</h1>
        </div>
      )
    }
  </div>

  <div class="wrap hero__content">
    {
      variant !== "overlap" && site.business.tagline && (
        <p class="eyebrow">{t(site.business.tagline, lang)}</p>
      )
    }
    {variant !== "overlap" && <h1 class="hero__title">{t(site.hero.headline, lang)}</h1>}
    {
      site.hero.subline && (
        <p class="hero__sub">{t(site.hero.subline, lang)}</p>
      )
    }

    <div class="hero__actions">
      {
        booking.enabled && (
          <a
            class="btn btn--primary"
            href={booking.href}
            {...(booking.external
              ? { target: "_blank", rel: "noopener" }
              : {})}
          >
            {ui(lang, "book")}
          </a>
        )
      }
      <a class="btn btn--ghost" href={telHref()}>
        {ui(lang, "call")} · {site.business.phone}
      </a>
    </div>
  </div>
</section>

<script>
  /*
   * Parallaxe du hero — repli pour les navigateurs sans `animation-timeline`,
   * Safari en tête. Là où le CSS suffit, ce script ne fait rien du tout : il
   * sort à la première ligne, et aucun écouteur n'est posé.
   *
   * Pourquoi ne pas s'en remettre au seul CSS : le site se montre sur un
   * téléphone, en clientèle. Un effet qui disparaît précisément sur l'appareil
   * de la démonstration ne sert à rien.
   *
   * Le déplacement est calculé dans requestAnimationFrame et jamais dans
   * l'écouteur de défilement : lire une position force un recalcul de mise en
   * page, et le faire à chaque cran de molette suffit à saccader la page.
   */
  const media = document.querySelector<HTMLElement>("[data-hero-media]");

  if (media && !CSS.supports("animation-timeline: view()")) {
    const doux = window.matchMedia("(prefers-reduced-motion: reduce)");

    let enAttente = false;

    const placer = () => {
      enAttente = false;
      const { top, height } = media.getBoundingClientRect();
      // Progression de l'image dans la fenêtre, de -1 (juste sous le bord bas)
      // à 1 (sortie par le haut). 0 quand elle occupe le centre.
      const vue = window.innerHeight || 1;
      const avancement = (top + height / 2 - vue / 2) / ((vue + height) / 2);
      const borne = Math.max(-1, Math.min(1, avancement));
      const img = media.querySelector("img");
      if (img) img.style.transform = `translateY(${(-borne * 14).toFixed(2)}%) scale(1.3)`;
    };

    const auProchainRendu = () => {
      if (enAttente) return;
      enAttente = true;
      requestAnimationFrame(placer);
    };

    const activer = () => {
      media.setAttribute("data-parallaxe", "");
      placer();
      addEventListener("scroll", auProchainRendu, { passive: true });
      addEventListener("resize", auProchainRendu, { passive: true });
    };

    const desactiver = () => {
      media.removeAttribute("data-parallaxe");
      const img = media.querySelector("img");
      if (img) img.style.transform = "";
      removeEventListener("scroll", auProchainRendu);
      removeEventListener("resize", auProchainRendu);
    };

    // Une préférence d'accessibilité peut changer en cours de visite : la
    // respecter une fois au chargement ne suffit pas.
    const appliquer = () => (doux.matches ? desactiver() : activer());
    doux.addEventListener("change", appliquer);
    appliquer();
  }
</script>
