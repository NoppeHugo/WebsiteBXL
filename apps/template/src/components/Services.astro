---
import type { Language } from "@bxl/schema";
import { formatPrice } from "@bxl/schema";
import { site, t } from "../lib/client.ts";
import { ui } from "../lib/i18n.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;

// Regroupement par catégorie, dans l'ordre d'apparition du fichier : le
// commerçant maîtrise ainsi la présentation de sa carte de tarifs.
const groups = new Map<string, typeof site.services>();
for (const service of site.services) {
  const key = t(service.category, lang) || "";
  const bucket = groups.get(key);
  if (bucket) bucket.push(service);
  else groups.set(key, [service]);
}

const grouped = [...groups.entries()];
const isSplit = grouped.length > 1;
---

<section class="section" id="services">
  <div class="wrap">
    <div class="section__head">
      <h2 class="section__title">{ui(lang, "services_title")}</h2>
    </div>

    <div class={`services${isSplit ? " services--split" : ""}`}>
      {
        grouped.map(([category, services]) => (
          <div class="service-group">
            {category && <h3 class="service-group__title">{category}</h3>}
            {services.map((service) => (
              <article class="service">
                <h4 class="service__name">{t(service.name, lang)}</h4>
                <p class="service__price">{formatPrice(service, lang)}</p>
                {/*
                  La durée n'existe que là où l'on prend rendez-vous. Chez un
                  fleuriste, « 30 min » sous le prix d'un bouquet ne veut rien
                  dire — et l'afficher vide donnerait « min » tout seul.
                */}
                {(service.durationMin !== undefined || service.description) && (
                  <p class="service__meta">
                    {service.durationMin !== undefined && (
                      <span class="service__duration">
                        {service.durationMin} {ui(lang, "minutes")}
                      </span>
                    )}
                    {service.description && (
                      <span class="service__desc">
                        {t(service.description, lang)}
                      </span>
                    )}
                  </p>
                )}
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
