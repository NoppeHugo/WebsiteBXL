# Bloc nginx de l'interface d'administration — équivalent de infra/admin.caddy.
#
# L'interface peut modifier et mettre hors ligne tous les sites clients : elle
# vit sur un sous-domaine distinct, jamais sur le domaine d'un client.
#
# Usage : voir api.conf.modele.

server {
    listen 80;
    listen [::]:80;
    server_name admin.@@DOMAINE@@;

    include snippets/bxl-commun.conf;

    # Filet supplémentaire devant l'authentification de l'application :
    # restreindre l'accès à quelques adresses connues divise par beaucoup la
    # surface exposée. Décommenter et compléter avec les adresses réelles de
    # l'exploitant — ne rien inventer ici, une adresse fausse enferme dehors.
    #
    # allow 203.0.113.4;
    # allow 198.51.100.0/24;
    # deny all;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;

        # La console construit et déploie les sites : une réponse peut mettre
        # bien plus longtemps qu'une page ordinaire à venir.
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Sans cette ligne, nginx applique sa limite par défaut d'un mégaoctet
        # et refuse la requête lui-même, avec un 413 que l'application ne voit
        # jamais. Une photo prise au téléphone en pèse trois à cinq : l'envoi
        # de photos échouait donc pour toutes les vraies photos, alors que le
        # code en accepte quarante mégaoctets (media.ts).
        client_max_body_size 40m;
    }
}
