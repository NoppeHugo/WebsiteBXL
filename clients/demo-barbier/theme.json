{
  "preset": {
    "style": "signature",
    "palette": "sauge"
  },
  "palette": {
    "bg": "#f6f7f4",
    "surface": "#eaeee6",
    "text": "#1a1f18",
    "muted": "#5f6b5c",
    "accent": "#2f4231",
    "accentText": "#f6f7f4",
    "border": "#d8e0d3"
  },
  "fonts": {
    "display": "Archivo, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "body": "Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displayWeight": 300,
    "displayTracking": "-0.04em",
    "displayTransform": "none",
    "uiTransform": "uppercase",
    "uiTracking": "0.18em"
  },
  "layout": {
    "hero": "overlap",
    "heroAlign": "start",
    "gallery": "strip",
    "nav": "solid"
  },
  "radius": "none",
  "grain": false,
  "effects": {
    "glass": false,
    "blur": 0,
    "reveal": true,
    "parallax": false
  }
}
