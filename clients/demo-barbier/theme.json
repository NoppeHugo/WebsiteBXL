{
  "preset": {
    "style": "studio",
    "palette": "sauge"
  },
  "palette": {
    "bg": "#f6f7f4",
    "surface": "#eaeee6",
    "text": "#1a1f18",
    "muted": "#5f6b5c",
    "accent": "#2f4231",
    "accentText": "#f6f7f4",
    "border": "#d8e0d3"
  },
  "fonts": {
    "display": "Oswald, 'Arial Narrow', -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "body": "Archivo, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displayWeight": 600,
    "displayTracking": "0.005em",
    "displayTransform": "uppercase",
    "uiTransform": "uppercase",
    "uiTracking": "0.2em"
  },
  "layout": {
    "hero": "fullbleed",
    "heroAlign": "start",
    "gallery": "mosaic",
    "nav": "overlay"
  },
  "radius": "none",
  "grain": false,
  "effects": {
    "glass": false,
    "blur": 0,
    "reveal": true,
    "parallax": true
  }
}
