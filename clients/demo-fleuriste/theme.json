{
  "preset": {
    "style": "naturemorte",
    "palette": "pivoine"
  },
  "palette": {
    "bg": "#fdf7f5",
    "surface": "#f7e9e6",
    "text": "#231519",
    "muted": "#6d5257",
    "accent": "#6b2740",
    "accentText": "#fdf7f5",
    "border": "#eed9d5"
  },
  "fonts": {
    "display": "Bitter, Georgia, 'Times New Roman', serif",
    "body": "Inter, -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "displayWeight": 500,
    "displayTracking": "-0.02em",
    "displayTransform": "none",
    "uiTransform": "uppercase",
    "uiTracking": "0.18em"
  },
  "layout": {
    "hero": "fullbleed",
    "heroAlign": "start",
    "gallery": "mosaic",
    "nav": "overlay"
  },
  "radius": "none",
  "grain": true,
  "effects": {
    "glass": false,
    "blur": 0,
    "reveal": true,
    "parallax": true
  }
}
