# Copier en `.env` (non versionné) et compléter.

# Serveur de déploiement, au format utilisateur@hôte.
DEPLOY_HOST=deploy@vps.exemple.be

# Adresse de contact Let's Encrypt (expiration et incidents de certificat).
# Utilisée par infra/setup-vps.sh, qui l'écrit dans /etc/caddy/caddy.env sur
# le serveur. Elle ne sert pas en local.
ACME_EMAIL=tonadresse@exemple.be

# Racine des sites sur le VPS.
DEPLOY_ROOT=/srv/sites

# Nombre de releases conservées par site (permet le retour arrière).
KEEP_RELEASES=5

# --- API de réservation et de contact ---

# Injecté au build des sites : sans lui, les formulaires ne sont pas rendus.
PUBLIC_API_URL=https://api.exemple.be

# Utilisé par `pnpm tenant` et par l'API en local.
DATABASE_URL=postgres://bxl@localhost:5432/bxl

# Mot de passe de la base en production (docker-compose).
POSTGRES_PASSWORD=

# Envoi des courriels. `log` en développement ; `resend` ou `smtp` en
# production — `log` y est refusé au démarrage.
EMAIL_DRIVER=log

# --- Option A : Resend (recommandé dès qu'un domaine est vérifié) ---
RESEND_API_KEY=

# --- Option B : relais SMTP d'un tiers, Gmail par exemple ---
# SMTP_PASS attend un **mot de passe d'application** (16 caractères), pas le
# mot de passe du compte : Gmail refuse ce dernier, et la validation en deux
# étapes doit être active pour pouvoir en créer un.
#
# Le chiffrement se déduit du port : 465 = TLS d'emblée, sinon STARTTLS.
#
# ⚠️ Gmail réécrit l'expéditeur avec l'adresse du compte. MAIL_FROM ne sera
# respecté que si l'adresse est déclarée comme alias vérifié dans Gmail
# (« Envoyer des e-mails en tant que »). Sinon, le client verra l'adresse
# Gmail. Plafond : 500 envois par jour sur un compte gratuit.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Les guillemets ne sont pas décoratifs : `scripts/deploy.sh` fait `source .env`,
# et bash lirait « < » comme une redirection. Sans eux, la lecture du fichier
# échoue **en entier** — donc DEPLOY_HOST aussi, et le déploiement s'arrête sur
# un message qui ne parle pas de MAIL_FROM. Docker Compose, lui, retire les
# guillemets ; la valeur transmise est la même dans les deux cas.
MAIL_FROM="Réservations <reservations@exemple.be>"

# --- Console d'administration ---

# Secret de signature des sessions. Le changer déconnecte tout le monde.
SESSION_SECRET=

# Chemin du clone du dépôt sur le VPS, monté dans le conteneur.
REPO_PATH=/srv/repo

# Clé SSH utilisée pour pousser vers GitHub et demander une publication.
SSH_KEY_PATH=/home/deploy/.ssh/id_ed25519

# Hôtes connus de cette clé. Sans l'empreinte de github.com, le push s'arrête
# sur une question à laquelle personne ne peut répondre.
SSH_KNOWN_HOSTS=/home/deploy/.ssh/known_hosts

# Compte propriétaire du dépôt sur l'hôte. La console emprunte son identité :
# en root, git refuse d'ouvrir un dépôt appartenant à quelqu'un d'autre, et
# plus rien ne s'enregistre. `id -u deploy` et `id -g deploy`.
DEPLOY_UID=1002
DEPLOY_GID=1002

# Machine qui construit et déploie les sites, au format utilisateur@hôte.
# La console ne peut pas s'en charger : son image n'embarque ni Astro ni le
# template, et « localhost » y désigne le conteneur. « hote » est le nom que
# Compose donne à la machine (extra_hosts).
PUBLISH_HOST=deploy@hote

# Le même dépôt que REPO_PATH, mais vu depuis l'hôte : la publication s'exécute
# là-bas, pas dans le conteneur. Compose le remplit à partir de REPO_PATH ;
# cette ligne ne sert qu'aux lancements hors Compose.
PUBLISH_REPO=/srv/repo

# Domaine sous lequel la console crée les sous-domaines des nouveaux clients :
# « Salon Marie » devient salon-marie.<ce domaine>. Il faut donc que son DNS
# accepte n'importe quel sous-domaine — un enregistrement générique « * ».
#
# Facultatif : à défaut, il est déduit de PUBLIC_ADMIN_URL en retirant son
# premier label (admin.hairbxl.be → hairbxl.be). Ne le renseigner que si les
# deux diffèrent.
# SERVICE_DOMAIN=

# Nom d'hôte de l'espace commerçant : c'est là que se connecte le coiffeur pour
# modifier ses horaires, ses fermetures, ses tarifs et ses photos. Servi par la
# même application que la console, qui décide de l'interface d'après ce nom.
#
# Un domaine par usage : l'adresse remise au client ne doit jamais mener à la
# console qui gouverne les trente sites. Laissé vide, les deux partagent
# l'adresse et seul le rôle du compte les sépare — bon en développement,
# insuffisant en clientèle.
PORTAL_HOST=mon.exemple.be

# --- Exploitation (sauvegarde, surveillance) ---

# Destinataire des alertes. À défaut, elles partent vers SMTP_USER.
ALERTES_EMAIL=

# Où sont déposées les sauvegardes de la base, et combien de jours on les garde.
SAUVEGARDE_DIR=/srv/sauvegardes
SAUVEGARDE_JOURS=30

# ⛔ Copie hors du serveur. Les sauvegardes ci-dessus vivent sur le même disque
# que la base : un disque perdu les emporte avec elle. Cette variable reçoit la
# commande à lancer, avec le chemin de l'archive en argument. Rien n'est écrit
# par défaut — une destination inventée donnerait l'illusion d'une copie.
#
#   SAUVEGARDE_DISTANTE="rclone copy --config /home/deploy/.config/rclone/rclone.conf"
SAUVEGARDE_DISTANTE=

# --- Stripe (abonnements) ---

# Clé secrète. Absente, les abonnements sont simplement désactivés.
STRIPE_SECRET_KEY=

# Secret de signature des notifications, donné par Stripe à la création du
# webhook pointant vers https://api.exemple.be/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# URL publique de l'interface d'administration, pour les retours de Stripe.
PUBLIC_ADMIN_URL=https://admin.exemple.be
