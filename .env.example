# Copier en `.env` (non versionné) et compléter.

# Serveur de déploiement, au format utilisateur@hôte.
DEPLOY_HOST=deploy@vps.exemple.be

# Adresse de contact Let's Encrypt (expiration et incidents de certificat).
# Utilisée par infra/setup-vps.sh, qui l'écrit dans /etc/caddy/caddy.env sur
# le serveur. Elle ne sert pas en local.
ACME_EMAIL=tonadresse@exemple.be

# Racine des sites sur le VPS.
DEPLOY_ROOT=/srv/sites

# Nombre de releases conservées par site (permet le retour arrière).
KEEP_RELEASES=5

# --- API de réservation et de contact ---

# Injecté au build des sites : sans lui, les formulaires ne sont pas rendus.
PUBLIC_API_URL=https://api.exemple.be

# Utilisé par `pnpm tenant` et par l'API en local.
DATABASE_URL=postgres://bxl@localhost:5432/bxl

# Mot de passe de la base en production (docker-compose).
POSTGRES_PASSWORD=

# Envoi des courriels. `log` en développement ; `resend` ou `smtp` en
# production — `log` y est refusé au démarrage.
EMAIL_DRIVER=log

# --- Option A : Resend (recommandé dès qu'un domaine est vérifié) ---
RESEND_API_KEY=

# --- Option B : relais SMTP d'un tiers, Gmail par exemple ---
# SMTP_PASS attend un **mot de passe d'application** (16 caractères), pas le
# mot de passe du compte : Gmail refuse ce dernier, et la validation en deux
# étapes doit être active pour pouvoir en créer un.
#
# Le chiffrement se déduit du port : 465 = TLS d'emblée, sinon STARTTLS.
#
# ⚠️ Gmail réécrit l'expéditeur avec l'adresse du compte. MAIL_FROM ne sera
# respecté que si l'adresse est déclarée comme alias vérifié dans Gmail
# (« Envoyer des e-mails en tant que »). Sinon, le client verra l'adresse
# Gmail. Plafond : 500 envois par jour sur un compte gratuit.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Les guillemets ne sont pas décoratifs : `scripts/deploy.sh` fait `source .env`,
# et bash lirait « < » comme une redirection. Sans eux, la lecture du fichier
# échoue **en entier** — donc DEPLOY_HOST aussi, et le déploiement s'arrête sur
# un message qui ne parle pas de MAIL_FROM. Docker Compose, lui, retire les
# guillemets ; la valeur transmise est la même dans les deux cas.
MAIL_FROM="Réservations <reservations@exemple.be>"

# --- Console d'administration ---

# Secret de signature des sessions. Le changer déconnecte tout le monde.
SESSION_SECRET=

# Chemin du clone du dépôt sur le VPS, monté dans le conteneur.
REPO_PATH=/srv/repo

# Clé SSH utilisée pour pousser vers GitHub et déployer les sites.
SSH_KEY_PATH=/root/.ssh/id_ed25519

# --- Stripe (abonnements) ---

# Clé secrète. Absente, les abonnements sont simplement désactivés.
STRIPE_SECRET_KEY=

# Secret de signature des notifications, donné par Stripe à la création du
# webhook pointant vers https://api.exemple.be/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# URL publique de l'interface d'administration, pour les retours de Stripe.
PUBLIC_ADMIN_URL=https://admin.exemple.be
